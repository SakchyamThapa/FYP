@model MVC.Models.AdminPanelViewModel

@{
    ViewData["Title"] = "Admin Panel";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Use common layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Link CSS -->
    <link rel="stylesheet" href="~/css/AdminPanel.css" asp-append-version="true" />
</head>
<body>
    <header>
        <h1>Admin Panel</h1>
        <p>Manage users, projects, and KPI metrics.</p>
    </header>

    <main class="admin-panel">
        <!-- Users Section -->
        <section class="users-section">
            <h2>Users and KPI</h2>
            <table>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>KPI Points</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.users)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.KPIPoints</td>
                            <td>
                                <button onclick="resetKPI(@user.Id)">Reset KPI</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <!-- Projects Section -->
        <section class="projects-section">
            <h2>Add New Project</h2>
            <form id="addProjectForm" method="post" action="/Admin/AddProject">
                <div>
                    <label for="name">Project Name:</label>
                    <input type="text" id="name" name="Name" required />
                </div>
                <div>
                    <label for="deadline">Deadline:</label>
                    <input type="date" id="deadline" name="Deadline" required />
                </div>
                <div>
                    <label for="description">Description:</label>
                    <textarea id="description" name="Description"></textarea>
                </div>
                <button type="submit">Add Project</button>
            </form>
        </section>
    </main>

    <footer>
        <p>&copy; 2024 Admin Panel. All rights reserved.</p>
    </footer>

    <!-- Link JavaScript -->
    <script src="~/js/AdminPanel.js" asp-append-version="true"></script>
</body>
</html>
