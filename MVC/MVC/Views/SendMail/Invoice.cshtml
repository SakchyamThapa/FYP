@{
    ViewData["Title"] = "Invoice Viewer";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure layout is correct
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice Viewer</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container my-5">
        <h1 class="text-center mb-4">Invoice Viewer</h1>

        <!-- Invoice Number Input Section -->
        <div class="mb-4">
            <label for="invoiceNumberInput" class="form-label">Enter Invoice Number:</label>
            <input type="text" id="invoiceNumberInput" class="form-control" placeholder="e.g., INV-12345">
            <button id="searchInvoice" class="btn btn-primary mt-3">Search Invoice</button>
        </div>

        <!-- Error Message Section -->
        <div id="errorMessage" class="alert alert-danger d-none" role="alert">
            Invoice not found. Please check the invoice number.
        </div>

        <!-- Invoice Display Section -->
        <div id="invoiceDisplay" class="invoice-container d-none">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <!-- Invoice Header -->
                        <div class="col-12 text-center mb-4">
                            <h2 class="card-title C=">Invoice</h2>
                            <p><strong>Invoice Number:</strong> <span id="invoiceNumber"></span></p>
                            <p><strong>Date:</strong> <span id="invoiceDate"></span></p>
                        </div>

                        <!-- Customer Info -->
                        <div class="col-12 col-md-6">
                            <h5>Customer Information</h5>
                            <p><strong>Name:</strong> <span id="customerName"></span></p>
                            <p><strong>Email:</strong> <span id="customerEmail"></span></p>
                            <p><strong>Phone:</strong> <span id="customerPhone"></span></p>
                            <p><strong>Address:</strong> <span id="customerAddress"></span></p>
                        </div>

                        <!-- Billing Info -->
                        <div class="col-12 col-md-6">
                            <h5>Billing Details</h5>
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td><strong>Subtotal:</strong></td>
                                        <td>$<span id="subtotal"></span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Tax:</strong></td>
                                        <td>$<span id="taxAmount"></span></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total:</strong></td>
                                        <td><strong>$<span id="totalAmount"></span></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Status and Notes -->
                        <div class="col-12">
                            <h5>Status & Notes</h5>
                            <p><strong>Status:</strong> <span id="status"></span></p>
                            <p><strong>Notes:</strong> <span id="notes"></span></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS (includes Popper.js) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/Invoice.js"></script>

    </body>

