@{
    ViewData["Title"] = "Trash Emails";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensure layout is correct
}

<h1>Trash Emails</h1>

<div class="email-list">
    @if (ViewBag.TrashEmails != null && ViewBag.TrashEmails.Count > 0)
    {
        foreach (var email in ViewBag.TrashEmails)
        {
            <div class="email-item">
                <strong>From:</strong> @email.From <br />
                <strong>Subject:</strong> @email.Subject <br />
                <button class="btn btn-success btn-sm mt-2" onclick="restoreEmail('@email.Id')">Restore</button>

            </div>
        }
    }
    else
    {
        <p>No emails in Trash.</p>
    }
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>
        function restoreEmail(emailId) {
        $.post('@Url.Action("RestoreEmail", "SendMail")', { id: emailId }, function (response) {
            if (response.success) {
                alert('Email restored.');
                location.reload();
            } else {
                alert('Failed to restore email.');
            }
        });
    }

</script>
