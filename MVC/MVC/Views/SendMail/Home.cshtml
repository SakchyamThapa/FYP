@model IEnumerable<MVC.Models.Project>


@{
    ViewData["Title"] = "User Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Use a common layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Link CSS -->
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
</head>
<body>
    <header>
        <h1>Welcome, @User.Identity.Name!</h1>
        <p>Here are your ongoing projects and their progress:</p>
    </header>

    <main class="dashboard">
        @if (Model.Any())
        {
            @foreach (var project in Model)
            {
                <div class="project-card">
                    <h2>@project.Name</h2>
                    <p><strong>Deadline:</strong> @project.Deadline.ToString("MM/dd/yyyy")</p>
                    <div class="progress-bar-container">
                        <div class="progress-bar" style="width: @project.Progress%;"></div>
                    </div>
                    <p>@project.Progress% Completed</p>
                    <button class="view-details" onclick="viewProject(@project.Id)">View Details</button>
                </div>
            }
        }
        else
        {
            <p class="no-projects">You have no ongoing projects. <a href="/Projects/Create">Create a new project</a> to get started!</p>
        }
    </main>

    <footer>
        <p>&copy; 2024 Your Company. All rights reserved.</p>
    </footer>

    <!-- Link JavaScript -->
    <script src="~/js/Home.js" asp-append-version="true"></script>
</body>
</html>
