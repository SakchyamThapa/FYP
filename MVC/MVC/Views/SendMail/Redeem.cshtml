@model MVC.Models.RedeemModel

@{
    ViewData["Title"] = "Redeem Points";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redeem Points</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/Redeem.css">
    <script src="/js/Redeem.js"></script>

</head>
<body>
    <div class="container">
        <header>
            <h1>Redeem Your Points</h1>
            <p>Welcome, @Model.Username!</p>
            <p>Your Available KPI Points: <strong>@Model.Points</strong></p>
        </header>
        <section class="redeem-items">
            <h2>Choose an Item to Redeem</h2>
            <div class="items">
                <!-- Redeemable items -->
                <div class="item">
                    <img src="/images/coffee.jpg" alt="Coffee">
                    <h3>Coffee</h3>
                    <p>Cost: 10 KPI Points</p>
                    <button onclick="redeemItem('Coffee', 10)">Redeem</button>
                </div>
                <div class="item">
                    <img src="/images/tea.jpg" alt="Tea">
                    <h3>Tea</h3>
                    <p>Cost: 8 KPI Points</p>
                    <button onclick="redeemItem('Tea', 8)">Redeem</button>
                </div>
                <div class="item">
                    <img src="/images/lamp.jpg" alt="Lamp">
                    <h3>Lamp</h3>
                    <p>Cost: 50 KPI Points</p>
                    <button onclick="redeemItem('Lamp', 50)">Redeem</button>
                </div>
                <div class="item">
                    <img src="/images/uber.jpg" alt="Uber">
                    <h3>Uber Ride</h3>
                    <p>Cost: 25 KPI Points</p>
                    <button onclick="redeemItem('Uber Ride', 25)">Redeem</button>
                </div>
                <div class="item">
                    <img src="/images/pen.jpg" alt="Pen">
                    <h3>Pen</h3>
                    <p>Cost: 5 KPI Points</p>
                    <button onclick="redeemItem('Pen', 5)">Redeem</button>
                </div>
            </div>
        </section>
    </div>
    <script>
                function redeemItem(itemName, cost) {
            if (confirm(`Do you want to redeem ${itemName} for ${cost} KPI points?`)) {
                fetch('/Redeem/RedeemItem', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        itemName: itemName,
                        cost: cost,
                        userId: '@Model.Id' // Pass logged-in user's Id
                    })
                })
                .then(response => {
                    if (response.ok) {
                        alert(`${itemName} redeemed successfully!`);
                        location.reload();
                    } else {
                        alert('Error redeeming item. Please try again.');
                    }
                });
            }
        }

    </script>
</body>
</html>
