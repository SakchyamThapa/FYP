        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\npackage \&quot;Presentation Layer\&quot; {\n    component \&quot;Web Application\&quot; as WebApp\n    component \&quot;Mobile Application\&quot; as MobileApp\n}\n\npackage \&quot;Business Logic Layer\&quot; {\n    component \&quot;Authentication Service\&quot; as AuthService\n    component \&quot;Task Management Service\&quot; as TaskService\n    component \&quot;Points Allocation Service\&quot; as PointsService\n    component \&quot;Leaderboard Service\&quot; as LeaderboardService\n    component \&quot;Reward Management Service\&quot; as RewardService\n    component \&quot;Feedback Management Service\&quot; as FeedbackService\n    component \&quot;Report Generation Service\&quot; as ReportService\n    component \&quot;Notification Service\&quot; as NotifyService\n}\n\npackage \&quot;Data Layer\&quot; {\n    database \&quot;User Database\&quot; as DB_User\n    database \&quot;Task Database\&quot; as DB_Task\n    database \&quot;Points Database\&quot; as DB_Points\n    database \&quot;Leaderboard Database\&quot; as DB_Leaderboard\n    database \&quot;Rewards Database\&quot; as DB_Rewards\n    database \&quot;Feedback Database\&quot; as DB_Feedback\n    database \&quot;Reports Database\&quot; as DB_Reports\n    database \&quot;Notifications Database\&quot; as DB_Notify\n}\n\npackage \&quot;External Services\&quot; {\n    component \&quot;Email Service\&quot; as EmailService\n    component \&quot;Push Notification Service\&quot; as PushService\n}\n\nWebApp --&gt; AuthService : \&quot;Login/Register\&quot;\nMobileApp --&gt; AuthService : \&quot;Login/Register\&quot;\nAuthService --&gt; DB_User : \&quot;Verify/Store User Data\&quot;\n\nWebApp --&gt; TaskService : \&quot;Create/View Tasks\&quot;\nMobileApp --&gt; TaskService : \&quot;Create/View Tasks\&quot;\nTaskService --&gt; DB_Task : \&quot;Store/Retrieve Task Data\&quot;\n\nTaskService --&gt; PointsService : \&quot;Task Completion\&quot;\nPointsService --&gt; DB_Points : \&quot;Allocate Points\&quot;\nPointsService --&gt; LeaderboardService : \&quot;Update Rankings\&quot;\nLeaderboardService --&gt; DB_Leaderboard : \&quot;Store Rankings\&quot;\nLeaderboardService --&gt; WebApp : \&quot;Display Leaderboard\&quot;\nLeaderboardService --&gt; MobileApp : \&quot;Display Leaderboard\&quot;\n\nWebApp --&gt; RewardService : \&quot;Redeem Points\&quot;\nMobileApp --&gt; RewardService : \&quot;Redeem Points\&quot;\nRewardService --&gt; DB_Rewards : \&quot;Store/Fetch Rewards Data\&quot;\n\nWebApp --&gt; FeedbackService : \&quot;Submit Feedback\&quot;\nMobileApp --&gt; FeedbackService : \&quot;Submit Feedback\&quot;\nFeedbackService --&gt; DB_Feedback : \&quot;Store Feedback\&quot;\n\nWebApp --&gt; NotifyService : \&quot;Trigger Notifications\&quot;\nNotifyService --&gt; DB_Notify : \&quot;Store Notification Data\&quot;\nNotifyService --&gt; EmailService : \&quot;Send Emails\&quot;\nNotifyService --&gt; PushService : \&quot;Send Push Notifications\&quot;\n\nWebApp --&gt; ReportService : \&quot;Generate Reports\&quot;\nReportService --&gt; DB_Reports : \&quot;Retrieve Data\&quot;\nReportService --&gt; WebApp : \&quot;Provide Reports\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="lr8YZyKbf4djvtUZeHPi-1">
