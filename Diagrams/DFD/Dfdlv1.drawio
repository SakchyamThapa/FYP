        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\n\nactor User as EMPLOYEE\nactor Admin as MANAGER\n\nrectangle \&quot;Sonic Points System\&quot; {\n    circle \&quot;1.0 User Authentication System\&quot; as AUTH\n    database \&quot;D1 User Database\&quot; as DB_USER\n\n    circle \&quot;2.0 Task Management\&quot; as TASK\n    database \&quot;D2 Task Database\&quot; as DB_TASK\n\n    circle \&quot;3.0 Notification System\&quot; as NOTIFY\n    database \&quot;D3 Notifications Database\&quot; as DB_NOTIFY\n\n    circle \&quot;4.0 Points Allocation System\&quot; as POINTS\n    database \&quot;D4 Points Database\&quot; as DB_POINTS\n\n    circle \&quot;5.0 Feedback Management\&quot; as FEEDBACK\n    database \&quot;D5 Feedback Database\&quot; as DB_FEEDBACK\n\n    circle \&quot;6.0 Leaderboard System\&quot; as LEADERBOARD\n    database \&quot;D6 Leaderboard Database\&quot; as DB_LEADERBOARD\n\n    circle \&quot;7.0 Reward Management\&quot; as REWARDS\n    database \&quot;D7 Rewards Database\&quot; as DB_REWARDS\n\n    circle \&quot;8.0 Report Generation\&quot; as REPORTS\n    database \&quot;D8 Reports Database\&quot; as DB_REPORTS\n}\n\nEMPLOYEE --&gt; AUTH : \&quot;Login/Register\&quot;\nAUTH --&gt; DB_USER : \&quot;Fetch Data/Verify\&quot;\nDB_USER --&gt; AUTH : \&quot;User Authenticated\&quot;\nAUTH --&gt; EMPLOYEE : \&quot;Access Granted\&quot;\n\nEMPLOYEE --&gt; TASK : \&quot;Create/Manage Tasks\&quot;\nTASK --&gt; DB_TASK : \&quot;Store/Update Tasks\&quot;\nDB_TASK --&gt; TASK : \&quot;Fetch Task Details\&quot;\nTASK --&gt; EMPLOYEE : \&quot;Task Saved\&quot;\n\nEMPLOYEE --&gt; POINTS : \&quot;Mark Task Complete\&quot;\nPOINTS --&gt; DB_POINTS : \&quot;Allocate Points\&quot;\nDB_POINTS --&gt; POINTS : \&quot;Fetch/Store Points Data\&quot;\nPOINTS --&gt; LEADERBOARD : \&quot;Update Rankings\&quot;\nLEADERBOARD --&gt; DB_LEADERBOARD : \&quot;Store Rankings\&quot;\nLEADERBOARD --&gt; EMPLOYEE : \&quot;Display Rankings\&quot;\n\nEMPLOYEE --&gt; NOTIFY : \&quot;Trigger Notifications\&quot;\nNOTIFY --&gt; DB_NOTIFY : \&quot;Store Notification Data\&quot;\nDB_NOTIFY --&gt; NOTIFY : \&quot;Fetch Notifications\&quot;\nNOTIFY --&gt; EMPLOYEE : \&quot;Send Notifications\&quot;\n\nEMPLOYEE --&gt; FEEDBACK : \&quot;Submit Feedback\&quot;\nFEEDBACK --&gt; DB_FEEDBACK : \&quot;Store Feedback\&quot;\nDB_FEEDBACK --&gt; FEEDBACK : \&quot;Fetch Feedback\&quot;\nFEEDBACK --&gt; MANAGER : \&quot;Provide Feedback Report\&quot;\n\nMANAGER --&gt; REPORTS : \&quot;Request Reports\&quot;\nREPORTS --&gt; DB_REPORTS : \&quot;Fetch Data\&quot;\nDB_REPORTS --&gt; REPORTS : \&quot;Generate Reports\&quot;\nREPORTS --&gt; MANAGER : \&quot;Provide Reports\&quot;\n\nMANAGER --&gt; REWARDS : \&quot;Manage Rewards\&quot;\nREWARDS --&gt; DB_REWARDS : \&quot;Store/Update Rewards\&quot;\nDB_REWARDS --&gt; REWARDS : \&quot;Fetch Rewards\&quot;\nREWARDS --&gt; MANAGER : \&quot;Confirm Changes\&quot;\n\nMANAGER --&gt; LEADERBOARD : \&quot;Monitor Rankings\&quot;\nLEADERBOARD --&gt; MANAGER : \&quot;View Rankings\&quot;\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="CRFqF1phYQkXBzCoCHNI-3">
